<mujoco model="orb_arm_6dof">
  <!--
    ORB 6-DOF arm — self-contained MJCF, no external meshes.

    A fixed-base articulated arm with 6 hinge joints (j1..j6) driven by
    6 position servos. Used by MujocoAdapter as the default real-dynamics
    backend. All units SI, all angles in radians.
  -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <default>
    <joint damping="1.0" armature="0.01"/>
    <geom type="capsule" size="0.03" rgba="0.4 0.6 0.9 1"/>
    <position kp="100"/>
  </default>

  <worldbody>
    <geom name="floor" type="plane" size="5 5 0.1" rgba="0.9 0.9 0.9 1"/>
    <body name="base" pos="0 0 0.1">
      <geom type="box" size="0.08 0.08 0.1" rgba="0.5 0.5 0.55 1"/>
      <body name="link1" pos="0 0 0.1">
        <joint name="j1" type="hinge" axis="0 0 1" range="-3.1416 3.1416"/>
        <geom fromto="0 0 0 0 0 0.25"/>
        <body name="link2" pos="0 0 0.25">
          <joint name="j2" type="hinge" axis="0 1 0" range="-2.6 2.6"/>
          <geom fromto="0 0 0 0 0 0.25"/>
          <body name="link3" pos="0 0 0.25">
            <joint name="j3" type="hinge" axis="0 1 0" range="-2.6 2.6"/>
            <geom fromto="0 0 0 0 0 0.22"/>
            <body name="link4" pos="0 0 0.22">
              <joint name="j4" type="hinge" axis="0 0 1" range="-3.1416 3.1416"/>
              <geom fromto="0 0 0 0 0 0.18"/>
              <body name="link5" pos="0 0 0.18">
                <joint name="j5" type="hinge" axis="0 1 0" range="-2.6 2.6"/>
                <geom fromto="0 0 0 0 0 0.15"/>
                <body name="link6" pos="0 0 0.15">
                  <joint name="j6" type="hinge" axis="0 0 1" range="-3.1416 3.1416"/>
                  <geom fromto="0 0 0 0 0 0.1"/>
                  <geom name="flange" type="sphere" size="0.045" pos="0 0 0.12"
                        rgba="0.9 0.4 0.3 1"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="j1" joint="j1"/>
    <position name="j2" joint="j2"/>
    <position name="j3" joint="j3"/>
    <position name="j4" joint="j4"/>
    <position name="j5" joint="j5"/>
    <position name="j6" joint="j6"/>
  </actuator>
</mujoco>
